# Port for the Vite dev server (npm run dev)
VITE_PORT=5173

# Where the dev server proxies /api requests (the FastAPI backend)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: full API origin when the built UI is hosted separately from the backend
# (leave empty when using the dev proxy or when the backend serves the built UI)
VITE_API_BASE=
