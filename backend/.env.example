# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Default matches docker-compose.yml (Postgres 16 on host port 5433).
# To use your own server instead, e.g. the local PostgreSQL on 5432:
#   DATABASE_URL=postgresql://athira:YOUR_PASSWORD@localhost:5432/sitebrain
DATABASE_URL=postgresql://sitebrain:sitebrain@localhost:5433/sitebrain
DB_POOL_MAX=10
# Used by the test suite only; this database is wiped on every test run.
TEST_DATABASE_URL=postgresql://sitebrain:sitebrain@localhost:5433/sitebrain_test

# Claude (optional). Without credentials the deterministic decision-tree engine runs alone.
ANTHROPIC_API_KEY=
SITEBRAIN_LLM=auto            # auto | on | off
SITEBRAIN_MODEL=claude-opus-5-5
SITEBRAIN_EFFORT=low          # low | medium | high

# Which LLM to use: auto | anthropic | groq | openai_compat
#   auto = Anthropic if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else the decision tree
SITEBRAIN_LLM_PROVIDER=auto

# Groq — free tier, key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b (faster), llama-3.3-70b-versatile

# Any OpenAI-compatible server, e.g. Ollama running locally (free, no key): ollama pull llama3.1:8b
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_MODEL=llama3.1:8b

# Semantic document search (hybrid with BM25 keyword search): auto | local | openai_compat | off
#   auto/local = fastembed model on this machine, free, downloads ~70 MB on first start
#   openai_compat = an /embeddings endpoint, e.g. Ollama: ollama pull nomic-embed-text
SITEBRAIN_EMBED=auto
SITEBRAIN_EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_OPENAI_BASE_URL=http://localhost:11434/v1
# EMBED_OPENAI_MODEL=nomic-embed-text
SITEBRAIN_EMBED_MIN_SIM=0.6     # how close a passage must be to count when it shares no keywords with the question

# Diagnostic policy (SRS §4.2)
SITEBRAIN_MAX_TURNS=5
SITEBRAIN_CONFIDENCE=0.85
SITEBRAIN_SURVEY=0               # checks asked together up front in one form (0 = one at a time, in the chat)

# Learning from resolved sessions: each confirmed fix tunes how common each cause is and how causes answer checks.
SITEBRAIN_LEARNING=true
SITEBRAIN_LEARN_STRENGTH=10      # the engineers' authored likelihoods count as this many sessions of evidence

# Reading attachments while SiteBrain troubleshoots (not once the issue is with an expert): voice notes are
# transcribed (any language, translated to English), photos and video frames are described and matched to the
# pending check, PDFs/spreadsheets are summarised. Uses GROQ_API_KEY by default (free tier); off = store only.
SITEBRAIN_MEDIA=on
MEDIA_STT_MODEL=whisper-large-v3-turbo
MEDIA_VISION_MODEL=qwen/qwen3.8-27b
# MEDIA_API_KEY=            # another OpenAI-compatible service instead of Groq
# MEDIA_BASE_URL=

# Escalation channels (optional)
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ESCALATION_EMAIL_TO=

# Administrator: created on first start when no user has this email; they add the operators and experts and set
# their passwords. The password is applied on every start: change it here and restart to change it (8+ characters).
SITEBRAIN_ADMIN_EMAIL=admin@gpsrenewables.com
SITEBRAIN_ADMIN_NAME=Administrator
SITEBRAIN_ADMIN_PASSWORD=change-me-please

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
